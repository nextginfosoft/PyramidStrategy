# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-this-to-exactly-32-bytes!!

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for local Windows dev (no PostgreSQL install needed)
DATABASE_URL=sqlite:///./pyramidstrategy.db

# PostgreSQL for production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/pyramidstrategy

# ─── Redis ────────────────────────────────────────────────────────────────────
# Set USE_FAKE_REDIS=true to run without a Redis server (local dev)
USE_FAKE_REDIS=true
REDIS_URL=redis://localhost:6379/0

# ─── Paper Trade ──────────────────────────────────────────────────────────────
# ALWAYS start with true — only flip to false after full validation
PAPER_TRADE=true

# ─── Zerodha (filled via Settings UI — leave blank here) ──────────────────────
KITE_API_KEY=
KITE_API_SECRET=

# ─── AI Provider (filled via Settings UI — leave blank here) ──────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Notifications (optional) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
